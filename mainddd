      local currentSafeBox = nil
      local currentTargetPart = nil

      local isFlying = false
      local flyHeight = 10
      local bodyVelocity = nil
      local bodyGyro = nil

      local function isBossAlive()
          if not boss or not boss.Parent then
              return false
          end
          local hum = boss:FindFirstChild("Humanoid")
          if hum and hum:IsA("Humanoid") and hum.Health <= 0 then
              return false
          end
          return true
      end

      local function findBoss()
          if not enemyFolder then
              return nil
          end
          boss = enemyFolder:FindFirstChild("CrystalGolem") or enemyFolder:FindFirstChild("Crystal Golem")
          return boss
      end

      local function getInnerBallSize()
          if not innerBall or not innerBall.Parent then
              return nil
          end
          return innerBall.Size
      end

      local function isInnerBallGrowing()
          local currentSize = getInnerBallSize()
          if not currentSize then
              return false
          end
          if not innerBallLastSize then
              innerBallLastSize = currentSize
              return false
          end
          local isGrowing = (currentSize - innerBallLastSize).Magnitude > 1.0
          innerBallLastSize = currentSize
          return isGrowing
      end

      local function isInnerBallSmall()
          local size = getInnerBallSize()
          if not size then
              return false
          end
          local target = Vector3.new(5.64, 5.66, 5.60)
          return math.abs(size.X - target.X) < 0.5 and
                math.abs(size.Y - target.Y) < 0.5 and
                math.abs(size.Z - target.Z) < 0.5
      end

      local function isInnerBallBig()
          local size = getInnerBallSize()
          if not size then
              return false
          end
          local target = Vector3.new(40, 20, 40)
          return math.abs(size.X - target.X) < 2 and
                math.abs(size.Y - target.Y) < 2 and
                math.abs(size.Z - target.Z) < 2
      end

      local function getBossPivot()
          if not boss or not boss.Parent or not boss:IsA("Model") then
              return nil
          end
          local success, pivot = pcall(function()
              return boss:GetPivot()
          end)
          return success and pivot or nil
      end

      local function disableFly()
          isFlying = false
          if currentTargetPart then
              currentTargetPart:Destroy()
              currentTargetPart = nil
          end
          if bodyVelocity then
              bodyVelocity:Destroy()
              bodyVelocity = nil
          end
          if bodyGyro then
              bodyGyro:Destroy()
              bodyGyro = nil
          end
      end

      local function teleportToBossWithHeight(height)
          character = player.Character
          if not isBossAlive() or not character then
              return false
          end
          local root = character:FindFirstChild("HumanoidRootPart")
          if not root then
              return false
          end
          if not boss or not boss.Parent then
              findBoss()
              if not boss then
                  return false
              end
          end
          local bossPivot = getBossPivot()
          if not bossPivot then
              return false
          end
          local targetHeight = height or normalHeight
          local targetPosition = bossPivot.Position + Vector3.new(0, targetHeight, 0)
          disableFly()
          root.CFrame = CFrame.new(targetPosition)
          flyHeight = targetHeight
          isAtMiddle = false
          local target = Instance.new("Part")
          target.Name = "BossTarget"
          target.Size = Vector3.new(1, 1, 1)
          target.Anchored = true
          target.CanCollide = false
          target.CanTouch = false
          target.CanQuery = false
          target.Transparency = 1
          target.Position = bossPivot.Position
          target.Parent = workspace
          currentTargetPart = target
          bodyVelocity = Instance.new("BodyVelocity")
          bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
          bodyVelocity.P = 10000
          bodyVelocity.Velocity = Vector3.zero
          bodyVelocity.Parent = root
          bodyGyro = Instance.new("BodyGyro")
          bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
          bodyGyro.P = 10000
          bodyGyro.CFrame = root.CFrame
          bodyGyro.Parent = root
          isFlying = true
          isAboveBoss = true
          isInSafeZone = false
          isInBuildZone = false
          isInSafeBox = false
          isWaitingForSafeBeam = false
          return true
      end

      local function teleportToBoss()
          if not isBossAlive() then
              return false
          end
          return teleportToBossWithHeight(normalHeight)
      end

      local function teleportToZone(targetPart, zoneName, centerMode)
          character = player.Character
          if not targetPart or not character then
              return false
          end
          local root = character:FindFirstChild("HumanoidRootPart")
          if not root then
              return false
          end
          disableFly()
          isFlying = false
          isAtMiddle = false
          local targetHeight = 0
          local targetCFrame
          if centerMode then
              targetCFrame = CFrame.new(targetPart.Position)
          else
              local topOffset = 0.5
              if zoneName and string.find(zoneName, "safeBox") then
                  topOffset = -0.5
              end
              targetHeight = targetPart.Size.Y / 2 + topOffset
              targetCFrame = CFrame.new(targetPart.Position + Vector3.new(0, targetHeight, 0))
          end
          root.CFrame = targetCFrame
          isAboveBoss = false
          if zoneName and string.find(zoneName, "safeBox") then
              local target = Instance.new("Part")
              target.Name = "SafeBoxTarget"
              target.Size = Vector3.new(1, 1, 1)
              target.Anchored = true
              target.CanCollide = false
              target.CanTouch = false
              target.CanQuery = false
              target.Transparency = 1
              target.Position = targetPart.Position
              target.Parent = workspace
              currentTargetPart = target
              flyHeight = targetHeight
              bodyVelocity = Instance.new("BodyVelocity")
              bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
              bodyVelocity.P = 10000
              bodyVelocity.Velocity = Vector3.zero
              bodyVelocity.Parent = root
              bodyGyro = Instance.new("BodyGyro")
              bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
              bodyGyro.P = 10000
              bodyGyro.CFrame = root.CFrame
              bodyGyro.Parent = root
              isFlying = true
          end
          return true
      end

      local function maintainPosition()
          character = player.Character
          if not isFlying or not currentTargetPart or not character then
              return
          end
          local root = character:FindFirstChild("HumanoidRootPart")
          if not root then
              return
          end
          if currentTargetPart.Name == "BossTarget" then
              local bossPivot = getBossPivot()
              if bossPivot then
                  currentTargetPart.Position = bossPivot.Position
              end
          end
          local targetPosition = currentTargetPart.Position + Vector3.new(0, flyHeight, 0)
          local direction = targetPosition - root.Position
          local distance = direction.Magnitude
          if distance > 0.5 then
              local speed = math.min(distance * 2, 24)
              if bodyVelocity then
                  bodyVelocity.Velocity = direction.Unit * speed
              end
          else
              if bodyVelocity then
                  bodyVelocity.Velocity = Vector3.zero
              end
          end
          if bodyGyro then
              if currentTargetPart.Name == "BossTarget" or isAboveBoss then
                  -- Position couchée horizontale (-) avec le regard braqué vers le boss
                  bodyGyro.CFrame = CFrame.lookAt(root.Position, currentTargetPart.Position, Vector3.new(0, 0, 1))
              else
                  bodyGyro.CFrame = CFrame.lookAt(root.Position, currentTargetPart.Position)
              end
          end
      end

      local function returnToBoss()
          if not isBossAlive() then
              disableFly()
              isFlying = false
              isAboveBoss = false
              isInBuildZone = false
              isWaitingForSafeBeam = false
              isInSafeZone = false
              hasStartedBuildingSupplies = false
              return false
          end
          hasStartedBuildingSupplies = false
          isDodgingOrb = false
          isAtMiddle = false
          return teleportToBoss()
      end

      local function handleInnerBallSizeChange()
          if not innerBall then
              return
          end
          if isInnerBallGrowing() then
              isDodgingOrb = false
              isAtMiddle = false
              if isAboveBoss and not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                  teleportToBossWithHeight(normalHeight)
              end
              return
          end
          if isInnerBallSmall() then
              if not isDodgingOrb then
                  isDodgingOrb = true
                  isAtMiddle = false
                  if isAboveBoss and not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                      teleportToBossWithHeight(orbHeight)
                  end
              end
          elseif isInnerBallBig() then
              if not isAtMiddle then
                  isDodgingOrb = false
                  isAtMiddle = false
                  if isAboveBoss and not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                      teleportToBossWithHeight(normalHeight)
                  end
              end
          else
              if isDodgingOrb and not isAtMiddle then
                  isDodgingOrb = false
                  isAtMiddle = false
                  if isAboveBoss and not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                      teleportToBossWithHeight(normalHeight)
                  end
              end
          end
      end

      local function setupInnerBallListener()
          if not innerBall or orbListenerConnected then
              return
          end
          innerBall:GetPropertyChangedSignal("Size"):Connect(handleInnerBallSizeChange)
          orbListenerConnected = true
          task.wait(0.1)
          handleInnerBallSizeChange()
      end

      local function findFollowOrb()
          followOrb = workspace:FindFirstChild("enchantedFirstBossFollowOrb")
          if followOrb then
              innerBall = followOrb:FindFirstChild("innerBall")
              if innerBall then
                  innerBallLastSize = innerBall.Size
                  setupInnerBallListener()
              end
          end
          return followOrb
      end

      local function handleFollowOrb()
          if not followOrb then
              findFollowOrb()
              if not followOrb then
                  return
              end
          end
          if not followOrb or not followOrb.Parent then
              followOrb = nil
              innerBall = nil
              innerBallLastSize = nil
              orbListenerConnected = false
              isDodgingOrb = false
              isAtMiddle = false
              if isAboveBoss and not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                  teleportToBossWithHeight(normalHeight)
              end
              return
          end
          if not innerBall or not innerBall.Parent then
              innerBall = followOrb:FindFirstChild("innerBall")
              if innerBall then
                  innerBallLastSize = innerBall.Size
                  orbListenerConnected = false
                  setupInnerBallListener()
              end
          end
      end

      local function getBuildBeams(beamPart)
          local beams = {}
          if not beamPart then
              return beams
          end
          for _, child in ipairs(beamPart:GetChildren()) do
              if child:IsA("Beam") and child.Name == "buildBeam" then
                  table.insert(beams, child)
              end
          end
          return beams
      end

      local function getSafeBeams(beamPart)
          local beams = {}
          if not beamPart then
              return beams
          end
          for _, child in ipairs(beamPart:GetChildren()) do
              if child:IsA("Beam") and child.Name == "safeBeam" then
                  table.insert(beams, child)
              end
          end
          return beams
      end

      local function getActiveBuildBeam(beamPart)
          for _, beam in ipairs(getBuildBeams(beamPart)) do
              if beam.Enabled then
                  return beam
              end
          end
          return nil
      end

      local function hasActiveBuildBeam(beamPart)
          return getActiveBuildBeam(beamPart) ~= nil
      end

      local function getActiveSafeBeam(beamPart)
          for _, beam in ipairs(getSafeBeams(beamPart)) do
              if beam.Enabled then
                  return beam
              end
          end
          return nil
      end

      local function hasActiveSafeBeam(beamPart)
          return getActiveSafeBeam(beamPart) ~= nil
      end

      local function isBuildingSuppliesActive()
          if not supplyModels then
              return false
          end
          for _, model in ipairs(supplyModels:GetChildren()) do
              if model:IsA("Model") then
                  local supplies = model:FindFirstChild("buildingSupplies")
                  if supplies and supplies:IsA("BasePart") and supplies.Transparency == 0 then
                      return true
                  end
              end
          end
          return false
      end

      local function checkCrystalDrop()
          if not isBossAlive() or not safeZones then
              return false
          end
          for _, part in ipairs(safeZones:GetChildren()) do
              if part:IsA("BasePart") and part.Transparency == 0 then
                  if not isInSafeZone then
                      teleportToZone(part, "Zone de sécurité (Crystal Drop)", false)
                      isInSafeZone = true
                      isInBuildZone = false
                      isInSafeBox = false
                      isWaitingForSafeBeam = false
                      isAboveBoss = false
                      hasStartedBuildingSupplies = false
                      isDodgingOrb = false
                      isAtMiddle = false
                  end
                  return true
              end
          end
          return false
      end

      local function checkBuildingSupplies()
          if not isBossAlive() or not supplyModels or not isBuildingSuppliesActive() then
              return false
          end
          if isInBuildZone or isWaitingForSafeBeam then
              return true
          end
          if hasStartedBuildingSupplies and not isInBuildZone and not isWaitingForSafeBeam then
              hasStartedBuildingSupplies = false
          end
          for supplyIndex, supplyModel in ipairs(supplyModels:GetChildren()) do
              if supplyModel:IsA("Model") then
                  local mainPart = supplyModel:FindFirstChild("mainPart")
                  local buildingSupplies = supplyModel:FindFirstChild("buildingSupplies")
                  if buildingSupplies and buildingSupplies:IsA("BasePart") and buildingSupplies.Transparency == 0 then
                      if not isInBuildZone and not isInSafeZone then
                          if mainPart and mainPart:IsA("BasePart") then
                              teleportToZone(mainPart, "mainPart_"..supplyIndex, false)
                              isInBuildZone = true
                              isAboveBoss = false
                              isWaitingForSafeBeam = false
                              hasStartedBuildingSupplies = true
                              isDodgingOrb = false
                              isAtMiddle = false
                              if not buildZones then
                                  return true
                              end
                              local foundActiveBeamPart = false
                              for buildIndex, buildModel in ipairs(buildZones:GetChildren()) do
                                  if buildModel:IsA("Model") then
                                      local beamPart = buildModel:FindFirstChild("beamPart")
                                      local safeBox = buildModel:FindFirstChild("safeBox")
                                      if beamPart and beamPart:IsA("BasePart") and safeBox and safeBox:IsA("BasePart") then
                                          if not hasActiveBuildBeam(beamPart) then
                                              continue
                                          end
                                          foundActiveBeamPart = true
                                          task.wait(0.5)
                                          teleportToZone(beamPart, "beamPart_"..buildIndex, false)
                                          currentBeamPart = beamPart
                                          currentSafeBox = safeBox
                                          local safeBeamFound = false
                                          local waitTime = 0
                                          while waitTime < 10 do
                                              if getActiveSafeBeam(beamPart) then
                                                  safeBeamFound = true
                                                  teleportToZone(safeBox, "safeBox_"..buildIndex, false)
                                                  isInSafeBox = true
                                                  isWaitingForSafeBeam = true
                                                  break
                                              end
                                              task.wait(0.5)
                                              waitTime = waitTime + 0.5
                                          end
                                          if not safeBeamFound then
                                              hasStartedBuildingSupplies = false
                                              returnToBoss()
                                              isInBuildZone = false
                                              return true
                                          end
                                          return true
                                      end
                                  end
                              end
                              if not foundActiveBeamPart then
                                  hasStartedBuildingSupplies = false
                                  returnToBoss()
                                  isInBuildZone = false
                                  return true
                              end
                          end
                      end
                      return true
                  end
              end
          end
          return false
      end

      local function checkSafeBeam()
          if not isWaitingForSafeBeam or not currentBeamPart then
              return
          end
          if not currentBeamPart.Parent then
              hasStartedBuildingSupplies = false
              returnToBoss()
              isInBuildZone = false
              isWaitingForSafeBeam = false
              isInSafeBox = false
              currentBeamPart = nil
              currentSafeBox = nil
              return
          end
          if not hasActiveSafeBeam(currentBeamPart) then
              hasStartedBuildingSupplies = false
              if returnToBoss() then
                  isInBuildZone = false
                  isWaitingForSafeBeam = false
                  isInSafeBox = false
                  currentBeamPart = nil
                  currentSafeBox = nil
                  isAboveBoss = true
              end
          end
      end

      local function resetAfterDeath()
          disableFly()
          isFlying = false
          if isInBuildZone or isWaitingForSafeBeam then
              hasStartedBuildingSupplies = true
          end
          isInSafeZone = false
          isInBuildZone = false
          isInSafeBox = false
          isWaitingForSafeBeam = false
          isAboveBoss = false
          isDodgingOrb = false
          isAtMiddle = false
          currentBeamPart = nil
          currentSafeBox = nil
          currentTargetPart = nil
          followOrb = nil
          innerBall = nil
          innerBallLastSize = nil
          orbListenerConnected = false
      end

      local function connectDeath(newHumanoid)
          if not newHumanoid then
              return
          end
          newHumanoid.Died:Connect(resetAfterDeath)
      end
      connectDeath(humanoid)

      player.CharacterAdded:Connect(function(newCharacter)
          resetAfterDeath()
          character = newCharacter
          humanoid = character:WaitForChild("Humanoid", 10)
          if not humanoid then
              return
          end
          rootPart = character:WaitForChild("HumanoidRootPart", 10)
          if not rootPart then
              return
          end
          task.wait(0.5)
          while humanoid.Health == 0 do
              task.wait(0.1)
          end
          character.PrimaryPart = rootPart
          connectDeath(humanoid)
          task.wait(0.5)
          findBoss()
          if boss and isBossAlive() then
              teleportToBoss()
              if hasStartedBuildingSupplies then
                  task.wait(0.5)
              end
          end
      end)

      RunService.Heartbeat:Connect(function()
          character = player.Character
          if not character then
              return
          end
          local root = character:FindFirstChild("HumanoidRootPart")
          if not root then
              return
          end
          if not isBossAlive() then
              if isFlying then
                  disableFly()
                  isFlying = false
                  isAboveBoss = false
                  isInBuildZone = false
                  isWaitingForSafeBeam = false
                  isInSafeZone = false
                  hasStartedBuildingSupplies = false
              end
              return
          end

          -- Signaler que le bot combat un boss actif
          isBossFighting = true

          if isFlying then
              maintainPosition()
          end
          if not boss or not boss.Parent then
              findBoss()
              if boss and isBossAlive() then
                  teleportToBoss()
              end
              return
          end
          handleFollowOrb()
          if isWaitingForSafeBeam then
              checkSafeBeam()
              return
          end
          if isInSafeZone then
              if not checkCrystalDrop() then
                  isInSafeZone = false
                  hasStartedBuildingSupplies = false
                  returnToBoss()
              end
              return
          end
          if not isInBuildZone and not isInSafeZone then
              checkBuildingSupplies()
          end
          if isInBuildZone and not isWaitingForSafeBeam then
              if not isBuildingSuppliesActive() then
                  isInBuildZone = false
                  hasStartedBuildingSupplies = false
                  returnToBoss()
              end
          end
          if hasStartedBuildingSupplies and not isInBuildZone and not isWaitingForSafeBeam and not isInSafeZone then
              if isBuildingSuppliesActive() then
                  checkBuildingSupplies()
              else
                  hasStartedBuildingSupplies = false
              end
          end
      end)

      workspace.ChildAdded:Connect(function(child)
          if child.Name == "enchantedFirstBossFollowOrb" then
              followOrb = child
              innerBall = followOrb:FindFirstChild("innerBall")
              if innerBall then
                  innerBallLastSize = innerBall.Size
                  orbListenerConnected = false
                  setupInnerBallListener()
              end
          end
      end)

      workspace.ChildRemoved:Connect(function(child)
          if child.Name == "enchantedFirstBossFollowOrb" then
              followOrb = nil
              innerBall = nil
              innerBallLastSize = nil
              orbListenerConnected = false
              isDodgingOrb = false
              isAtMiddle = false
              if not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                  if isAboveBoss and isBossAlive() then
                      teleportToBossWithHeight(normalHeight)
                  end
              end
          end
      end)

      local function setupBuildZoneListeners(buildModel)
          if not buildModel or not buildModel:IsA("Model") then
              return
          end
          local beamPart = buildModel:FindFirstChild("beamPart")
          if not beamPart or not beamPart:IsA("BasePart") then
              return
          end
          for _, safeBeam in ipairs(getSafeBeams(beamPart)) do
              if not safeBeam:GetAttribute("CrystalGolemListenerConnected") then
                  safeBeam:SetAttribute("CrystalGolemListenerConnected", true)
                  safeBeam:GetPropertyChangedSignal("Enabled"):Connect(function()
                      if safeBeam.Enabled and isWaitingForSafeBeam and currentBeamPart == beamPart then
                          if currentSafeBox then
                              teleportToZone(currentSafeBox, "safeBox", false)
                              isInSafeBox = true
                          end
                      elseif not safeBeam.Enabled and isWaitingForSafeBeam and currentBeamPart == beamPart then
                          if hasActiveSafeBeam(beamPart) then
                              return
                          end
                          hasStartedBuildingSupplies = false
                          returnToBoss()
                          isInBuildZone = false
                          isWaitingForSafeBeam = false
                          isInSafeBox = false
                          currentBeamPart = nil
                          currentSafeBox = nil
                          isAboveBoss = true
                      end
                  end)
              end
          end
          if not beamPart:GetAttribute("CrystalGolemChildListenerConnected") then
              beamPart:SetAttribute("CrystalGolemChildListenerConnected", true)
              beamPart.ChildAdded:Connect(function(child)
                  if child:IsA("Beam") and child.Name == "safeBeam" then
                      task.wait()
                      setupBuildZoneListeners(buildModel)
                      if child.Enabled and isWaitingForSafeBeam and currentBeamPart == beamPart then
                          if currentSafeBox then
                              teleportToZone(currentSafeBox, "safeBox", false)
                              isInSafeBox = true
                          end
                      end
                  end
              end)
          end
      end

      if buildZones then
          for _, model in ipairs(buildZones:GetChildren()) do
              if model:IsA("Model") then
                  setupBuildZoneListeners(model)
              end
          end
          buildZones.ChildAdded:Connect(function(child)
              if child:IsA("Model") then
                  task.wait(0.1)
                  setupBuildZoneListeners(child)
              end
          end)
      end

      if safeZones then
          for _, part in ipairs(safeZones:GetChildren()) do
              if part:IsA("BasePart") then
                  part:GetPropertyChangedSignal("Transparency"):Connect(function()
                      if part.Transparency == 0 and not isInBuildZone and not isWaitingForSafeBeam then
                          checkCrystalDrop()
                      end
                  end)
              end
          end
      end

      if supplyModels then
          for _, model in ipairs(supplyModels:GetChildren()) do
              if model:IsA("Model") then
                  local supplies = model:FindFirstChild("buildingSupplies")
                  if supplies and supplies:IsA("BasePart") then
                      supplies:GetPropertyChangedSignal("Transparency"):Connect(function()
                          if supplies.Transparency == 0 and not isInSafeZone and not isWaitingForSafeBeam then
                              checkBuildingSupplies()
                          end
                      end)
                  end
              end
          end
      end

      if enemyFolder then
          enemyFolder.ChildAdded:Connect(function(child)
              if child.Name == "CrystalGolem" or child.Name == "Crystal Golem" then
                  boss = child
                  if not isInSafeZone and not isInBuildZone and not isWaitingForSafeBeam then
                      task.wait(0.2)
                      teleportToBoss()
                  end
              end
          end)
      end

      findBoss()
      findFollowOrb()
      if boss and isBossAlive() then
          task.wait(0.2)
          teleportToBoss()
      end
  end)

