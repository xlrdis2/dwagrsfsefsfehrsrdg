    if gui.Name == "PlayerGui" then
        task.wait(0.5)
        applyAllModifications()
    end
end

applyAllModifications()

if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

if LocalPlayer:FindFirstChild("PlayerGui") then
    onPlayerGuiAdded(LocalPlayer.PlayerGui)
end

LocalPlayer.ChildAdded:Connect(onPlayerGuiAdded)

local function periodicCheck()
    while true do
        task.wait(5)
        
        local character = LocalPlayer.Character
        if character then
            local nameplate = character:FindFirstChild("playerNameplate")
            if nameplate then
                local frame = nameplate:FindFirstChild("Frame")
                if frame then
                    local nameText = frame:FindFirstChild("name")
                    if nameText and nameText.Text ~= NEW_NAME then
                        nameText.Text = NEW_NAME
                    end
                end
            end
        end
        
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local playerStatus = playerGui:FindFirstChild("playerStatus")
            if playerStatus then
                local frame = playerStatus:FindFirstChild("Frame")
                if frame then
                    local playerName = frame:FindFirstChild("playerName")
                    if playerName and playerName.Text ~= NEW_NAME then
                        playerName.Text = NEW_NAME
                    end
                    
                    local moneyMain = frame:FindFirstChild("moneyMain")
                    if moneyMain then
                        local textLabel = moneyMain:FindFirstChild("TextLabel")
                        if textLabel and textLabel.Text ~= NEW_MONEY_TEXT then
                            textLabel.Text = NEW_MONEY_TEXT
                        end
                        
                        if NEW_GEMS_TEXT ~= "" then
                            local gemsText = moneyMain:FindFirstChild("GemsText")
                            if gemsText and gemsText.Text ~= NEW_GEMS_TEXT then
                                gemsText.Text = NEW_GEMS_TEXT
                            end
                        end
                    end
                    
                    local levelBorder = frame:FindFirstChild("levelBorder")
                    if levelBorder then
                        local level = levelBorder:FindFirstChild("level")
                        if level and level.Text ~= NEW_LEVEL_TEXT then
                            level.Text = NEW_LEVEL_TEXT
                        end
                    end
                end
            end
        end
    end
end

task.spawn(periodicCheck)

task.spawn(function()
    task.wait(1)
    checkInventory()
end)
end
