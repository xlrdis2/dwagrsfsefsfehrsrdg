local function clearAccessories(char)
    if not char or not char.Parent then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum:RemoveAccessories()
        end)
    end
    
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Accoutrement") 
           or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("Clothing") 
           or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
            pcall(function() item:Destroy() end)
        end
    end
    
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Accoutrement") or item:IsA("WrapLayer") then
            pcall(function() item:Destroy() end)
        end
    end
end

local function hasRemainingAccessories(char)
    if not char then return false end
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Accoutrement") 
           or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("Clothing") 
           or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") or item:IsA("WrapLayer") then
            return true
        end
    end
    return false
end

local function ensureAccessoriesCleared(char)
    if not char then return true end
    
    local attempts = 0
    while hasRemainingAccessories(char) and attempts < 10 do
        clearAccessories(char)
        attempts = attempts + 1
        task.wait(0.1)
    end
    
    local remaining = hasRemainingAccessories(char)
    return not remaining
end

