local function shouldKeepItem(item)
    if not item then return false end
    local asConfig = (currentConfig and currentConfig.AutoSell) or {}
    local keepNames = asConfig.KEEP_NAMES or {}
    local keepContains = asConfig.KEEP_NAME_CONTAINS or {}
    
    for _, keepName in ipairs(keepNames) do
        if item.name == keepName then
            return true
        end
    end
    
    for _, keyword in ipairs(keepContains) do
        if item.name and string.find(item.name, keyword) then
            return true
        end
    end
    
    return false
end

local function isRarityAllowed(r, sellRarities)
    if not sellRarities then return false end
    local normR = normalizeRarity(r)
    if type(sellRarities) == "table" then
        if sellRarities[normR] ~= nil then
            return sellRarities[normR] == true
        end
        for k, v in pairs(sellRarities) do
            if type(k) == "string" and normalizeRarity(k) == normR then
                return v == true
            end
        end
        for _, val in ipairs(sellRarities) do
            if type(val) == "string" and normalizeRarity(val) == normR then
                return true
            end
        end
    end
    return false
end

local function isTypeAllowed(t, sellTypes)
    if not sellTypes then return false end
    local lowerT = string.lower(tostring(t))
    if type(sellTypes) == "table" then
        if sellTypes[lowerT] ~= nil then
            return sellTypes[lowerT] == true
        end
        for k, v in pairs(sellTypes) do
            if type(k) == "string" and string.lower(k) == lowerT then
                return v == true
            end
        end
        for _, val in ipairs(sellTypes) do
            if type(val) == "string" and string.lower(val) == lowerT then return true end
        end
    end
    return false
end

local function getItemsToSell()
    local inventory = getInventory()
    if not inventory then
        return {}
    end
    
    local asConfig = (currentConfig and currentConfig.AutoSell) or {}
    local sellRarities = asConfig.SELL_RARITIES or { common = false, uncommon = true, rare = false, epic = false, legendary = false, ultimate = false }
    local sellTypes = asConfig.SELL_TYPES or { weapon = true, helmet = true, chest = true, ability = false }
    local keepEquipped = (asConfig.KEEP_EQUIPPED ~= false)
    local keepUpgraded = (asConfig.KEEP_UPGRADED ~= false)
    local minLevelToKeep = asConfig.MIN_LEVEL_TO_KEEP or 0
    
    local itemsToSell = {}
    local categories = {
        weapons = "weapon",
        abilities = "ability",
        chests = "chest",
        helmets = "helmet"
    }
    
    for category, typeName in pairs(categories) do
        if isTypeAllowed(typeName, sellTypes) then
            local items = inventory[category]
            if items then
                for id, item in pairs(items) do
                    local number = tonumber(string.match(tostring(id), "%d+$"))
                    local shouldSell = true
                    
                    if shouldKeepItem(item) then
                        shouldSell = false
                    end
                    
                    if shouldSell and not isRarityAllowed(item.rarity, sellRarities) then
                        shouldSell = false
                    end
                    
                    if shouldSell and keepEquipped and item.equipped == true then
                        shouldSell = false
                    end
                    
                    if shouldSell and keepUpgraded and item.currentUpgrade and item.currentUpgrade > 0 then
                        shouldSell = false
                    end
                    
                    if shouldSell and minLevelToKeep and minLevelToKeep > 0 and item.levelReq and item.levelReq >= minLevelToKeep then
                        shouldSell = false
                    end
                    
                    if shouldSell and (not item.sellPrice or item.sellPrice <= 0) then
                        shouldSell = false
                    end
                    
                    if shouldSell and number then
                        table.insert(itemsToSell, {
                            type = typeName,
                            number = number,
                            name = item.name,
                            rarity = normalizeRarity(item.rarity),
                            sellPrice = item.sellPrice,
                            levelReq = item.levelReq,
                            currentUpgrade = item.currentUpgrade,
                            maxUpgrades = item.maxUpgrades
                        })
                    end
                end
            end
        end
    end
    
    table.sort(itemsToSell, function(a, b)
        return (a.sellPrice or 0) < (b.sellPrice or 0)
    end)
    
    return itemsToSell
end

