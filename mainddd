        value = "```\n" .. table.concat(dStatsLines, "\n") .. "\n```",
        inline = false
    })
    
    -- 3. Items Drops (Inline Card Boxes)
    local maxItems = math.min(#batchItems, 20)
    for i = 1, maxItems do
        local drop = batchItems[i]
        local rarityKey = normalizeRarity(drop.rarity)
        local rarityData = RARITY[rarityKey] or RARITY.common
        
        local itemLines = {}
        table.insert(itemLines, "Rarity: " .. rarityData.display)
        
        local nameLower = string.lower(drop.name or "")
        local itemClass = string.lower(tostring(drop.class or drop.armorClass or drop.type or ""))
        
        local isMage = itemClass == "mage" 
            or nameLower:find("mage") 
            or (drop.spellPower and drop.spellPower > 0 and (not drop.physicalPower or drop.physicalPower == 0))
            
        local isGuardian = itemClass == "guardian" 
            or nameLower:find("guardian") 
            or (drop.health and drop.health > 0 and (not drop.physicalPower or drop.physicalPower == 0) and (not drop.spellPower or drop.spellPower == 0))
            
        if isMage then
            if drop.spellPower and drop.spellPower > 0 then
                table.insert(itemLines, "Spell: " .. formatNumber(drop.spellPower))
            end
            if drop.health and drop.health > 0 then
                table.insert(itemLines, "Health: " .. formatNumber(drop.health))
            end
        elseif isGuardian then
            if drop.health and drop.health > 0 then
                table.insert(itemLines, "Health: " .. formatNumber(drop.health))
            end
        else
            local potVal = (drop.physicalPower and drop.physicalPower > 0 and drop.physicalPower) 
                or (drop.physicalDamage and drop.physicalDamage > 0 and drop.physicalDamage) 
                or 0
            if potVal > 0 then
                table.insert(itemLines, "Potential: " .. formatNumber(potVal))
            end
            if drop.health and drop.health > 0 then
                table.insert(itemLines, "Health: " .. formatNumber(drop.health))
            end
        end
        
        if drop.sellPrice and drop.sellPrice > 0 then
            table.insert(itemLines, "Price: " .. formatNumber(drop.sellPrice))
        end
        
        local itemName = drop.name or "Item"
        if not itemName:find("%+%d+") and drop.currentUpgrade and drop.currentUpgrade > 0 then
            itemName = itemName .. " +" .. tostring(drop.currentUpgrade)
        end
        
        table.insert(fields, {
            name = itemName,
            value = "```\n" .. table.concat(itemLines, "\n") .. "\n```",
            inline = true
        })
    end
    
    if #batchItems > 20 then
        table.insert(fields, {
            name = "📦 Extra Items",
            value = string.format("```\n+%d items non affichés\n```", #batchItems - 20),
            inline = false
        })
    end
    
    local pingContent = nil
    local triggeredRarity = nil
    local whConfig = (currentConfig and currentConfig.Webhook) or {}
    
    for _, drop in ipairs(batchItems) do
        local r = normalizeRarity(drop.rarity)
        if whConfig[r] == true then
            triggeredRarity = RARITY[r] and RARITY[r].display or r:upper()
            break
        end
    end
    
    if triggeredRarity then
        local targetId = getgenv().DiscordUserId or (whConfig and whConfig.DiscordUserId) or DISCORD_USER_ID or ""
        if targetId ~= "" then
            if targetId == "everyone" or targetId == "@everyone" then
                pingContent = string.format("@everyone 🌟 **Drop %s !**", triggeredRarity)
            elseif targetId == "here" or targetId == "@here" then
                pingContent = string.format("@here 🌟 **Drop %s !**", triggeredRarity)
            else
                local cleanId = tostring(targetId):gsub("[<@!>]", "")
                pingContent = string.format("<@%s> 🌟 **Drop %s !**", cleanId, triggeredRarity)
            end
        else
            pingContent = string.format("🌟 **Drop %s !**", triggeredRarity)
        end
    end
    
    local payload = {
        username = "Drops Dungeon",
        avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(LocalPlayer.UserId) .. "&width=150&height=150&format=png",
        content = pingContent,
        embeds = {{
