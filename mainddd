      local safeZones = workspace:FindFirstChild("firstBossSafeZones")
      local supplyModels = workspace:FindFirstChild("firstBossSupplyModels")
      local buildZones = workspace:FindFirstChild("firstBossBuildZones")

      local boss = nil
      local followOrb = nil
      local innerBall = nil
      local innerBallLastSize = nil
      local orbListenerConnected = false

      local isInSafeZone = false
      local isInBuildZone = false
      local isInSafeBox = false
      local isWaitingForSafeBeam = false
      local isAboveBoss = false
      local hasStartedBuildingSupplies = false

      local isDodgingOrb = false
