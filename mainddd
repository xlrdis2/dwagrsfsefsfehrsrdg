local RARITY = {
    common = { emoji = "⬜", color = 0x989898, name = "COMMON", display = "Common" },
    uncommon = { emoji = "🟩", color = 0x5BC250, name = "UNCOMMON", display = "Uncommon" },
    rare = { emoji = "🟦", color = 0x4B4DC3, name = "RARE", display = "Rare" },
    epic = { emoji = "🟪", color = 0x92469F, name = "EPIC", display = "Epic" },
    legendary = { emoji = "🟧", color = 0xF49A09, name = "LEGENDARY", display = "Legendary" },
    ultimate = { emoji = "🔴", color = 0xFF0000, name = "ULTIMATE", display = "Ultimate" }
}

local function normalizeRarity(rawRarity)
    if not rawRarity then return "common" end
    local lower = string.lower(tostring(rawRarity))
    lower = string.gsub(lower, "%s+", "")
    if RARITY[lower] then return lower end
    if string.find(lower, "common") and not string.find(lower, "uncommon") then return "common" end
    if string.find(lower, "uncommon") then return "uncommon" end
    if string.find(lower, "rare") then return "rare" end
    if string.find(lower, "epic") then return "epic" end
    if string.find(lower, "legendary") then return "legendary" end
    if string.find(lower, "ultimate") then return "ultimate" end
    return lower
end

local function formatNumber(num)
    if not num or type(num) ~= "number" then return "0" end
    if num >= 1e9 then
        local s = string.format("%.2f", num / 1e9):gsub("%.?0+$", "")
        return s .. "B"
    elseif num >= 1e6 then
        local s = string.format("%.2f", num / 1e6):gsub("%.?0+$", "")
        return s .. "M"
    elseif num >= 1e3 then
        local s = string.format("%.2f", num / 1e3):gsub("%.?0+$", "")
        return s .. "K"
    else
        return tostring(math.floor(num))
    end
end

