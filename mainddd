local function isReplayButtonVisible()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local mainInterface = playerGui:FindFirstChild("mainInterface")
    local buttons = mainInterface and mainInterface:FindFirstChild("buttons")
    local optionsButton = buttons and buttons:FindFirstChild("optionsButton")
    local replayButton = optionsButton and optionsButton:FindFirstChild("ReplayDungeonButton")
    
    if replayButton and replayButton:IsA("GuiObject") then
        return replayButton.Visible
    end
    return false
end

local function performReplay()
    if isReplaying or not autoReplayEnabled then return end
    
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    local replayEvent = remotes and remotes:FindFirstChild("replayDungeon")
    if not replayEvent then return end
    
    isReplaying = true
    
    local progress = getDungeonProgress()
    local name = getDungeonName()
    
    local shouldReplay = progress == "noLivesLeft" 
        or progress == "hardcoreFailed" 
        or progress == "bossKilled"
        or progress == "playersNotReady"
        or progress == "outOfTime"
    
    if not shouldReplay or not isReplayButtonVisible() then
        isReplaying = false
        return
    end
    
    -- 🛑 1. ENVOYER OBLIGATOIREMENT LE WEBHOOK AVANT QUE REPLAY NE SE DÉCLENCHE
    ensureWebhookSentBeforeReplay(progress)
    
    -- 📦 2. VÉRIFICATION DE L'INVENTAIRE EN DONJON ET RETOUR LOBBY POUR VENDRE
    local maxThreshold = (currentConfig and currentConfig.AutoSell and currentConfig.AutoSell.MaxInventoryThreshold) or 290
    local itemCount = checkInventory()
    
    if itemCount >= maxThreshold then
        teleportToLobby()
        isReplaying = false
        return
    end
    
    local replayData = {
        dungeonProgress = progress,
        dungeonStarted = false,
        hardcore = false,
        dungeonFinished = false,
        dungeonName = name,
        isHardcore = false,
        fightingBoss = false
    }
    
    pcall(function()
        replayEvent:FireServer(replayData)
    end)
    
    task.wait(2)
    isReplaying = false
end

local function checkAndReplay()
    if not autoReplayEnabled then return end
    
    local progress = getDungeonProgress()
    local shouldReplay = progress == "noLivesLeft" 
        or progress == "hardcoreFailed" 
        or progress == "bossKilled"
        or progress == "playersNotReady"
        or progress == "outOfTime"
    
    if shouldReplay and isReplayButtonVisible() then
        performReplay()
    end
end

local function onDungeonProgressChanged(val)
    if val == "dungeonStarted" or val == "" then
        webhookSentForCurrentRound = false
    end
    checkAndReplay()
end

