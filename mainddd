local function ensureWebhookSentBeforeReplay(progress)
    if webhookSentForCurrentRound then
        return true
    end
    
    if progress == "bossKilled" then
        local startWait = tick()
        task.wait(1.5)
        local lastCount = #batchItems
        while (tick() - startWait < 3.5) do
            if #batchItems ~= lastCount then
                lastCount = #batchItems
                task.wait(0.5)
            else
                break
            end
        end
    end

    local currentInv = getInventory()
    if currentInv and oldInventory then
        local categories = {"weapons", "abilities", "chests", "helmets"}
        for _, category in ipairs(categories) do
            if currentInv[category] and oldInventory[category] then
                for id, item in pairs(currentInv[category]) do
                    if not oldInventory[category][id] then
                        local idStr = tostring(id)
                        local num = tonumber(string.match(idStr, "%d+$")) or 0
                        local typeName = category:sub(1, -2)
                        addToBatch(item, typeName, num)
                    end
                end
            end
        end
    end
    
    if batchTimer then
        task.cancel(batchTimer)
        batchTimer = nil
    end
    
    local success = false
    local attempts = 0
    local maxAttempts = 3
    
    while not success and attempts < maxAttempts do
        attempts = attempts + 1
        if #batchItems > 0 then
            success = sendBatchToDiscord()
        else
            success = sendDungeonSummary(progress)
        end
        
        if not success and attempts < maxAttempts then
        print("✅ Webhook Discord confirmé et transmis avec succès !")
    else
        print("❌ Webhook non envoyé après " .. tostring(maxAttempts) .. " tentatives.")
    end
    
    webhookSentForCurrentRound = true
    
    -- 4. Délai de sécurité indispensable (2.0s) pour s'assurer que la requête HTTP est entièrement finalisée avant Replay
    task.wait(2.0)
    return success
end



