    table.insert(lines, '    "legendary": ' .. tostring(data.Webhook.legendary == true) .. ',')
    table.insert(lines, '    "ultimate": ' .. tostring(data.Webhook.ultimate == true))
    table.insert(lines, '  },')
    
    -- 🛒 Section 5: Auto-Sell & Gestion Inventaire
    local function formatArray(tbl)
        if not tbl or #tbl == 0 then return "[]" end
        local items = {}
        for _, v in ipairs(tbl) do
            table.insert(items, '"' .. tostring(v) .. '"')
        end
        return "[" .. table.concat(items, ", ") .. "]"
    end

    local sr = data.AutoSell.SELL_RARITIES or {}
