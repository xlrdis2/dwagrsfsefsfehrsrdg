  local function GetDistanceToHitboxEdge(pos, zonePart)
      if not IsPartActive(zonePart) then return 999 end

      local localPos = zonePart.CFrame:PointToObjectSpace(pos)
      local halfSize = zonePart.Size / 2

      local nameLower = string.lower(zonePart.Name)
      local parentName = zonePart.Parent and string.lower(zonePart.Parent.Name) or ""
      local isCircleType = string.find(nameLower, "circle") or string.find(nameLower, "poison") or string.find(parentName, "circle") or string.find(parentName, "poison")

      local isCylinder = false
      if zonePart:IsA("Part") then
          pcall(function()
              if zonePart.Shape == Enum.PartType.Cylinder or zonePart.Shape == Enum.PartType.Ball then
                  isCylinder = true
              end
          end)
      end

      -- 🟢 Détection circulaire radiale exacte pour tous les poisons / cercles
      if isCylinder or isCircleType then
          local radius = math.max(halfSize.X, halfSize.Z)
          if isCylinder and zonePart.Shape == Enum.PartType.Cylinder then
              radius = math.max(halfSize.Y, halfSize.Z)
          end
          local dist2D = math.sqrt(localPos.X * localPos.X + localPos.Z * localPos.Z)
          return dist2D - radius
      end

      -- Hitbox rectangulaire (Box)
      local dx = math.max(0, math.abs(localPos.X) - halfSize.X)
      local dz = math.max(0, math.abs(localPos.Z) - halfSize.Z)
      
      if math.abs(localPos.X) <= halfSize.X and math.abs(localPos.Z) <= halfSize.Z then
          local insideX = halfSize.X - math.abs(localPos.X)
          local insideZ = halfSize.Z - math.abs(localPos.Z)
          return -math.min(insideX, insideZ)
      end
      
      return math.sqrt(dx * dx + dz * dz)
  end

  local function ScanActiveAttacks(playerPos)
      local activeOrbs = {}
      local activeHitboxes = {}
      local isPlayerInDanger = false

      for _, descendant in ipairs(workspace:GetDescendants()) do
          if IsDescendantOfAnyPlayer(descendant) then
              continue
          end

          local nameLower = string.lower(descendant.Name)

          -- Orbes (battleMageOrb)
          for _, orbName in ipairs(CONFIG.ORB_NAMES) do
              if string.find(nameLower, orbName) then
                  local part = nil
                  if descendant:IsA("BasePart") then
                      part = descendant
                  elseif descendant:IsA("Model") then
                      part = descendant:FindFirstChildWhichIsA("BasePart") or descendant.PrimaryPart
                  end

                  if IsPartActive(part) then
                      table.insert(activeOrbs, part)
                      if (playerPos - part.Position).Magnitude <= CONFIG.ORB_DANGER_DISTANCE then
                          isPlayerInDanger = true
                      end
                  end
              end
          end

          -- Hitbox / Precast (mushroomWizardShot, spearmanHitbox, poisonCircle, etc.)
          if descendant:IsA("Model") or descendant:IsA("Folder") then
              local children = descendant:GetChildren()
              local hitboxes = {}
              local precasts = {}

              for _, child in ipairs(children) do
                  if child:IsA("BasePart") then
                      local cName = string.lower(child.Name)
                      if cName == "hitbox" then
                          table.insert(hitboxes, child)
                      elseif cName == "precast" or string.find(cName, "poison") or string.find(cName, "circle") then
                          table.insert(precasts, child)
                      end
                  end
              end

              if #hitboxes > 0 and #precasts > 0 then
                  for i, hitBoxPart in ipairs(hitboxes) do
                      local precastPart = precasts[i] or precasts[1]
                      if IsPartActive(precastPart) and IsPartActive(hitBoxPart) then
                          table.insert(activeHitboxes, hitBoxPart)
                          if GetDistanceToHitboxEdge(playerPos, hitBoxPart) <= CONFIG.DANGER_TRIGGER_MARGIN then
                              isPlayerInDanger = true
                          end
                      end
                  end
              elseif #precasts > 0 then
                  for _, precastPart in ipairs(precasts) do
                      if IsPartActive(precastPart) then
                          table.insert(activeHitboxes, precastPart)
                          if GetDistanceToHitboxEdge(playerPos, precastPart) <= CONFIG.DANGER_TRIGGER_MARGIN then
                              isPlayerInDanger = true
                          end
                      end
                  end
              end
          elseif descendant:IsA("BasePart") then
              if (nameLower == "precast" or string.find(nameLower, "poison") or string.find(nameLower, "spearman")) then
                  if IsPartActive(descendant) then
                      table.insert(activeHitboxes, descendant)
                      if GetDistanceToHitboxEdge(playerPos, descendant) <= CONFIG.DANGER_TRIGGER_MARGIN then
                          isPlayerInDanger = true
                      end
                  end
              end
          end
      end

      return isPlayerInDanger, activeOrbs, activeHitboxes
  end

  local GetEnemies, GetHRP, FindBestEnemy

  local function GetBestSafePosition(playerPos, activeOrbs, activeHitboxes)
      -- OPTIMISATION POISONCIRCLE : TP DIRECTEMENT EN FACE DU POISON VERS L'ENNEMI / DIRECTION AVANT
      local targetEnemy = FindBestEnemy and FindBestEnemy()
      local dirToTarget = nil
      local hrp = HRP or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
      
      if targetEnemy then
          local enemyHRP = GetHRP and GetHRP(targetEnemy)
          if enemyHRP then
              local diff = (enemyHRP.Position - playerPos)
              if diff.Magnitude > 0.1 then
                  dirToTarget = Vector3.new(diff.X, 0, diff.Z).Unit
              end
          end
      end
      if not dirToTarget and hrp then
          local look = hrp.CFrame.LookVector
          dirToTarget = Vector3.new(look.X, 0, look.Z).Unit
      end

      if dirToTarget then
          -- 1. POISONCIRCLE : TP EN DEHORS DE LA ZONE (RETOURS A L'ANCIEN COMPORTEMENT)
          for _, hb in ipairs(activeHitboxes) do
              local edgeDist = GetDistanceToHitboxEdge(playerPos, hb)
              if edgeDist <= CONFIG.DANGER_TRIGGER_MARGIN then
                  local hbName = string.lower(hb.Name)
                  local pName = hb.Parent and string.lower(hb.Parent.Name) or ""
                  if string.find(hbName, "poison") or string.find(hbName, "circle") or string.find(pName, "poison") or string.find(pName, "circle") then
                      local diff = (hb.Position - playerPos)
                      local dirToZone = diff.Magnitude > 0.1 and Vector3.new(diff.X, 0, diff.Z).Unit or dirToTarget
                      local radius = math.max(hb.Size.X, hb.Size.Y, hb.Size.Z) / 2
                      
                      local candidate = hb.Position - (dirToZone * (radius + CONFIG.HITBOX_SAFE_MARGIN))
                      candidate = Vector3.new(candidate.X, playerPos.Y, candidate.Z)

                      local isCandidateSafe = true
                      for _, otherHb in ipairs(activeHitboxes) do
                          if otherHb ~= hb and GetDistanceToHitboxEdge(candidate, otherHb) < CONFIG.HITBOX_SAFE_MARGIN then
                              isCandidateSafe = false
                              break
                          end
                      end
                      for _, orb in ipairs(activeOrbs) do
                          if (candidate - orb.Position).Magnitude <= CONFIG.ORB_DANGER_DISTANCE then
                              isCandidateSafe = false
                              break
                          end
                      end

                      if isCandidateSafe then
                          return candidate
                      end
                  end
              end
          end

          -- 2. BATTLEMAGEORB : TP SEULEMENT SI L'ORBE EST VRAIMENT DANGEREUSE ET PROCHE DU JOUEUR
          for _, orb in ipairs(activeOrbs) do
              local orbDist = (playerPos - orb.Position).Magnitude
              if orbDist <= CONFIG.ORB_DANGER_DISTANCE then
                  local diff = (orb.Position - playerPos)
                  local dirToOrb = diff.Magnitude > 0.1 and Vector3.new(diff.X, 0, diff.Z).Unit or dirToTarget
                  
                  local candidate = orb.Position - (dirToOrb * (CONFIG.ORB_DANGER_DISTANCE + 0.5))
                  candidate = Vector3.new(candidate.X, playerPos.Y, candidate.Z)

                  local isCandidateSafe = true
                  for _, otherHb in ipairs(activeHitboxes) do
                      if GetDistanceToHitboxEdge(candidate, otherHb) < CONFIG.HITBOX_SAFE_MARGIN then
                          isCandidateSafe = false
                          break
                      end
                  end
                  for _, o in ipairs(activeOrbs) do
                      if o ~= orb and (candidate - o.Position).Magnitude <= CONFIG.ORB_DANGER_DISTANCE then
                          isCandidateSafe = false
                          break
                      end
                  end

                  if isCandidateSafe then
                      return candidate
                  end
              end
          end
      end

      local directions = {}
      for i = 0, 15 do
          local angle = (i / 16) * math.pi * 2
          table.insert(directions, Vector3.new(math.cos(angle), 0, math.sin(angle)))
      end

      local bestPos = playerPos
      local bestScore = -math.huge
      local testDistances = { 3, 5, 8, 12, 16, 22 }

      for _, distStep in ipairs(testDistances) do
          for _, dir in ipairs(directions) do
              local candidate = playerPos + (dir * distStep)
              candidate = Vector3.new(candidate.X, playerPos.Y, candidate.Z)

              local minEdgeDist = math.huge
              for _, hb in ipairs(activeHitboxes) do
                  local d = GetDistanceToHitboxEdge(candidate, hb)
                  if d < minEdgeDist then minEdgeDist = d end
              end

              local minOrbDist = math.huge
              for _, orb in ipairs(activeOrbs) do
                  local d = (candidate - orb.Position).Magnitude
                  if d < minOrbDist then minOrbDist = d end
              end

              if #activeHitboxes == 0 then minEdgeDist = 50 end
              if #activeOrbs == 0 then minOrbDist = 50 end

              local isHitboxSafe = (#activeHitboxes == 0) or (minEdgeDist >= CONFIG.HITBOX_SAFE_MARGIN)
              local isOrbSafe = (#activeOrbs == 0) or (minOrbDist > CONFIG.ORB_DANGER_DISTANCE)

              if isHitboxSafe and isOrbSafe then
                  local score = 100 - distStep + (minEdgeDist * 0.1)
                  if score > bestScore then
                      bestScore = score
                      bestPos = candidate
                  end
              end
          end
          if bestScore > -math.huge then break end
      end

      if bestScore == -math.huge then
          for _, distStep in ipairs({ 8, 14, 20, 28, 36 }) do
              for _, dir in ipairs(directions) do
                  local candidate = playerPos + (dir * distStep)
                  candidate = Vector3.new(candidate.X, playerPos.Y, candidate.Z)

                  local minEdgeDist = math.huge
                  for _, hb in ipairs(activeHitboxes) do
                      local d = GetDistanceToHitboxEdge(candidate, hb)
                      if d < minEdgeDist then minEdgeDist = d end
                  end

                  if minEdgeDist > bestScore then
                      bestScore = minEdgeDist
                      bestPos = candidate
                  end
              end
          end
      end

      return bestPos
  end

