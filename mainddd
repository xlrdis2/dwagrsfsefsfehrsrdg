local function addToBatch(rawItem, typeName, number)
    local resolved = resolveItemData(rawItem)
    if not resolved then return end
    
    local numVal = number or 0
    
    for _, existing in ipairs(batchItems) do
        if existing.name == resolved.name and (existing.number == numVal or numVal == 0) then
            return
        end
    end
    
    table.insert(batchItems, {
        name = resolved.name,
        rarity = resolved.rarity,
        type = typeName or "item",
        number = numVal,
        physicalPower = resolved.physicalPower,
        health = resolved.health,
        spellPower = resolved.spellPower,
        levelReq = resolved.levelReq,
        sellPrice = resolved.sellPrice,
        currentUpgrade = resolved.currentUpgrade,
        maxUpgrades = resolved.maxUpgrades,
        class = resolved.class
    })
end

