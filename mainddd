              if child.Name == "Ancient Enchanted Tree" then
                  boss = child
                  task.wait(0.2)
                  corePart = getCorePart()
                  if corePart then
                      teleportToBoss()
                  end
              end
          end)
      end
      setupBossListeners()

      RunService.Stepped:Connect(function()
          if (isFlying or isOnBoss) and character then
              for _, part in ipairs(character:GetDescendants()) do
                  if part:IsA("BasePart") and part.CanCollide then
                      part.CanCollide = false
                  end
              end
          end
      end)

      RunService.Heartbeat:Connect(function()
          character = player.Character
          if not character then
              return
          end
          
          local root = character:FindFirstChild("HumanoidRootPart")
          if not root then
              return
          end
          
          if not boss or not boss.Parent then
              findBoss()
              if boss then
                  corePart = getCorePart()
                  if corePart then
                      teleportToBoss()
                  end
              else
                  if isFlying then
                      disableFly()
                      isFlying = false
                      isOnBoss = false
                  end
                  return
              end
          end
          
          if boss and not corePart then
              corePart = getCorePart()
              if corePart then
                  teleportToBoss()
              end
          end

          -- Signaler que le bot combat un boss actif
          isBossFighting = true
          
          -- Noclip (0 collision) pendant le boss Ancient Enchanted Tree
          for _, part in ipairs(character:GetDescendants()) do
              if part:IsA("BasePart") and part.CanCollide then
                  part.CanCollide = false
              end
          end

          if isFlying then
              maintainPosition()
          end
          
          if not isOnBoss and boss and corePart then
              if isRespawning then
                  forceTeleportToBoss()
                  isRespawning = false
              else
                  teleportToBoss()
              end
          end
      end)

      findBoss()
      if boss then
          task.wait(0.2)
          corePart = getCorePart()
          if corePart then
              teleportToBoss()
          end
      end
  end)

