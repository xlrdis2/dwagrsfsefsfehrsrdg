  --------------------------------------------------
  -- FONCTIONS DE COMBAT MOBS NORMAUX
  --------------------------------------------------
  local function GetEnemies()
      local enemies = {}
      local enemiesFolder = workspace:FindFirstChild("enemies")
      if enemiesFolder then
          for _, enemy in ipairs(enemiesFolder:GetChildren()) do
              if enemy:IsA("Model") then
                  local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                  if humanoid and humanoid.Health > 0 and enemy ~= LocalPlayer.Character then
                      ClearModelAccessories(enemy)
                      table.insert(enemies, enemy)
                  end
              end
          end
      end
      
      for _, folder in ipairs(workspace:GetDescendants()) do
          if folder:IsA("Folder") and folder.Name == "enemyFolder" then
              for _, enemy in ipairs(folder:GetChildren()) do
                  if enemy:IsA("Model") then
                      local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                      if humanoid and humanoid.Health > 0 and enemy ~= LocalPlayer.Character then
                          ClearModelAccessories(enemy)
                          table.insert(enemies, enemy)
                      end
                  end
              end
          end
      end
      return enemies
  end

  local function GetPosition(inst)
      if not inst then return nil end
      if inst:IsA("BasePart") then
          return inst.Position
      elseif inst:IsA("Model") then
          if inst.PrimaryPart then
              return inst.PrimaryPart.Position
          end
          local part = inst:FindFirstChildWhichIsA("BasePart", true)
          if part then
              return part.Position
          end
          local success, cf = pcall(function() return inst:GetBoundingBox() end)
          if success and cf then
              return cf.Position
          end
      end
      return nil
  end

  local function GetHRP(model)
      if not model then return nil end
      if model:IsA("BasePart") then return model end
      
      local hrp = model:FindFirstChild("HumanoidRootPart") 
          or model:FindFirstChild("Torso") 
          or model.PrimaryPart 
          or model:FindFirstChild("UpperTorso")
          
      if hrp then
          if hrp:IsA("BasePart") then
              return hrp
          elseif hrp:IsA("Model") or hrp:IsA("Folder") then
              return hrp.PrimaryPart or hrp:FindFirstChildWhichIsA("BasePart", true)
          end
      end
      
      return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
  end

  local function FindBestEnemy()
      local enemies = GetEnemies()
      if #enemies == 0 then return nil end
      local bestEnemy = nil
      local bestDistance = math.huge
      local playerPos = HRP and HRP.Position
      if not playerPos then return nil end
      
      for _, enemy in ipairs(enemies) do
          local enemyHRP = GetHRP(enemy)
          local enemyPos = GetPosition(enemyHRP)
          if enemyPos then
              local distance = (playerPos - enemyPos).Magnitude
              if distance < bestDistance then
                  bestDistance = distance
                  bestEnemy = enemy
              end
          end
      end
      return bestEnemy
  end

  local function GetEquippedWeapon()
      local character = LocalPlayer.Character
      if not character then return nil end
      local weaponValue = LocalPlayer:FindFirstChild("weaponEquipped")
      if weaponValue then
          if weaponValue:IsA("ObjectValue") then
              return weaponValue.Value
          elseif weaponValue:IsA("StringValue") then
              return character:FindFirstChild(weaponValue.Value)
          end
      end
      local dualRight = character:FindFirstChild("dualRight")
      if dualRight then return dualRight end
      
      for _, child in ipairs(character:GetChildren()) do
          if child:IsA("Tool") and child:FindFirstChild("swing") then
              return child
          end
      end
      return nil
  end

  local function SwingWeapon()
      local weapon = GetEquippedWeapon()
      if not weapon then return end
      local swing = weapon:FindFirstChild("swing")
      if swing and swing:IsA("RemoteEvent") then
          pcall(function() swing:FireServer() end)
      end
  end

  local function UseSpells()
      local backpack = LocalPlayer:FindFirstChild("Backpack")
      if not backpack then return end
      local abilityUsed = ReplicatedStorage:FindFirstChild("remotes")
      if abilityUsed then abilityUsed = abilityUsed:FindFirstChild("abilityUsed") end
      if not abilityUsed then return end
      
      for _, tool in ipairs(backpack:GetChildren()) do
          if tool:IsA("Tool") then
              local abilitySlot = tool:FindFirstChild("abilitySlot")
              if not abilitySlot then continue end
              local slot = string.lower(tostring(abilitySlot.Value))
              if slot ~= "q" and slot ~= "e" then continue end
              
              local cooldown = tool:FindFirstChild("cooldown")
              if cooldown then
                  local value = cooldown.Value
                  if cooldown:IsA("BoolValue") then
                      if value == true then continue end
                  elseif typeof(value) == "number" then
                      if value > 0 then continue end
                  end
              end
              
              pcall(function()
                  abilityUsed:FireServer(slot, tool)
                  local spellEvent = tool:FindFirstChild("spellEvent")
                  if spellEvent and spellEvent:IsA("RemoteEvent") then spellEvent:FireServer() end
                  local abilityEvent = tool:FindFirstChild("abilityEvent")
                  if abilityEvent and abilityEvent:IsA("RemoteEvent") then abilityEvent:FireServer() end
              end)
          end
      end
  end

  local function GetActiveBossHRP()
      local dungeon = workspace:FindFirstChild("dungeon")
      if not dungeon then return nil, nil end
      
      -- Boss 1 : Crystal Golem (Room 2)
      local room2 = dungeon:FindFirstChild("room2")
      if room2 then
          local ef = room2:FindFirstChild("enemyFolder")
          if ef then
              local g = ef:FindFirstChild("CrystalGolem") or ef:FindFirstChild("Crystal Golem")
              if g and g.Parent then
                  local hum = g:FindFirstChildOfClass("Humanoid")
                  if hum and hum.Health > 0 then
                      local hrp = g:FindFirstChild("HumanoidRootPart") or g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart")
                      return hrp, "CrystalGolem"
                  end
              end
          end
      end
      
      -- Boss 2 : Ancient Enchanted Tree (Room 5)
      local room5 = dungeon:FindFirstChild("room5")
      if room5 then
          local ef = room5:FindFirstChild("enemyFolder")
          if ef then
              local t = ef:FindFirstChild("Ancient Enchanted Tree")
              if t and t.Parent then
                  local core = t:FindFirstChild("Core")
                  local inner = core and core:FindFirstChild("inner")
                  local hrp = inner or t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
                  return hrp, "AncientTree"
              end
          end
      end

      return nil, nil
  end

  --------------------------------------------------
  -- BOUCLE DE COMBAT ET D'ATTAQUE UNIFIÉE
  --------------------------------------------------
  local function CombatLoop()
      local swingTimer = 0
      local spellTimer = 0
      local lastDragonSpellTime = 0
      local spellDelay = 0.2
      local lastAngle = 0
      local lastLogTime = 0
      local enemyCount = 0
      
      while true do
          Character = LocalPlayer.Character
          if not Character then task.wait(0.5) continue end
          
          HRP = Character:FindFirstChild("HumanoidRootPart")
          Humanoid = Character:FindFirstChildOfClass("Humanoid")
          if not HRP or not HRP.Parent or not Humanoid then task.wait(0.5) continue end
          
          Humanoid.Sit = false
          Humanoid.PlatformStand = false

          -- SI UN BOSS EST EN COURS : REGARDER ET ORIENTER LES ATTAQUES VERS LE BOSS
          local bossPart, bossType = GetActiveBossHRP()
          if isBossFighting or bossPart then
              local bossPos = GetPosition(bossPart)
              if bossPos and HRP then
                  local dist = (HRP.Position - bossPos).Magnitude
                  local maxCombatRange = (bossType == "Dragon") and (CONFIG.DRAGON_SPELL_RANGE or 1000) or CONFIG.COMBAT_RANGE_BOSS

                  if dist <= maxCombatRange then
                      HRP.CFrame = CFrame.lookAt(HRP.Position, bossPos)
                  end

                  local dt = task.wait(0.1)
                  swingTimer = swingTimer + dt
                  if swingTimer >= CONFIG.SWING_DELAY then
                      if dist <= CONFIG.COMBAT_RANGE_BOSS then
                          SwingWeapon()
                      end
                      swingTimer = 0
                  end

                  spellTimer = spellTimer + dt
                  if spellTimer >= spellDelay then
                      -- 🔥 Lancer les sorts jusqu'à DRAGON_SPELL_RANGE (1000m) sur le Dragon !
                      if dist <= maxCombatRange then
                          UseSpells()
                      end
                      spellTimer = 0
                  end
                  continue
              end
          end

          -- MODE NORMAL : COMBAT SUR MOBS NORMAUX
          if isDodgeActive then
              task.wait(0.05)
              continue
          end

          Humanoid.WalkSpeed = CONFIG.MOVE_SPEED
          Humanoid.AutoRotate = false
          
          local enemy = FindBestEnemy()
          if not enemy then task.wait(0.5) continue end
          local enemyHRP = GetHRP(enemy)
          local enemyPos = GetPosition(enemyHRP)
          if not enemyPos then task.wait(0.5) continue end
          
          local playerPos = HRP.Position
          local distance = (playerPos - enemyPos).Magnitude
          
          local lookPos = Vector3.new(enemyPos.X, HRP.Position.Y, enemyPos.Z)
          HRP.CFrame = CFrame.lookAt(HRP.Position, lookPos)
          
          local currentTime = os.clock()
          if currentTime - lastLogTime > 5 then
              local enemies = GetEnemies()
              if #enemies ~= enemyCount then
                  enemyCount = #enemies
              end
              lastLogTime = currentTime
          end
          
          if distance < CONFIG.SAFE_DISTANCE then
              local dir = (playerPos - enemyPos).Unit
              local retreatPos = playerPos + dir * CONFIG.SAFE_DISTANCE
              Humanoid:MoveTo(retreatPos)
              task.wait()
              continue
          end
          
          if distance > CONFIG.COMBAT_RANGE then
              -- 🔥 Tir de sorts à 500m sur le Dragon sans interrompre la course à pied
              local enemyName = string.lower(enemy.Name)
              if string.find(enemyName, "dragon") and distance <= 500 then
                  local currentTime = os.clock()
                  if currentTime - lastDragonSpellTime >= 0.25 then
                      lastDragonSpellTime = currentTime
                      task.spawn(UseSpells)
                  end
              end

              Humanoid.WalkSpeed = CONFIG.MOVE_SPEED
              Humanoid:MoveTo(enemyPos)
              task.wait()
              continue
          end
          
          lastAngle = lastAngle + 0.02
          if lastAngle > math.pi * 2 then
              lastAngle = lastAngle - math.pi * 2
          end
          
          local strafeX = math.cos(lastAngle) * CONFIG.STRAFE_DISTANCE
          local strafeZ = math.sin(lastAngle) * CONFIG.STRAFE_DISTANCE
          
          local targetPos = enemyPos + Vector3.new(strafeX, 0, strafeZ)
          Humanoid:MoveTo(targetPos)
          
          local lookPosAfterMove = Vector3.new(enemyPos.X, HRP.Position.Y, enemyPos.Z)
          HRP.CFrame = CFrame.lookAt(HRP.Position, lookPosAfterMove)
          
          local dt = task.wait()
          
          swingTimer = swingTimer + dt
          if swingTimer >= CONFIG.SWING_DELAY then
              SwingWeapon()
              swingTimer = 0
          end
          
          spellTimer = spellTimer + dt
          if spellTimer >= spellDelay then
              UseSpells()
              spellTimer = 0
          end
      end
  end

  --------------------------------------------------
  -- DÉMARRER LE COMBAT
  --------------------------------------------------
  CombatLoop()
