local function IsInLobby()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local introGui = playerGui:FindFirstChild("introGui")
    if not introGui then return false end
    
    if introGui:IsA("ScreenGui") then
        return introGui.Enabled
    end
    return false
end

local function IsStartButtonVisible()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local startButton = nil
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            startButton = gui:FindFirstChild("startButton")
            if startButton then break end
        end
    end
    if not startButton then startButton = playerGui:FindFirstChild("startButton") end
    if not startButton then return false end
    
    if startButton:IsA("ScreenGui") then
        return startButton.Enabled
    elseif startButton:IsA("GuiObject") then
        return startButton.Visible
    end
    return false
end

