local function PrettyPrintJSON(data)
    local lines = { "{" }
    
    -- 📌 Section 1: Création & Gestion du Donjon
    table.insert(lines, '  "Dungeon": {')
    table.insert(lines, '    "dungeonName": "' .. tostring(data.Dungeon.dungeonName) .. '",')
    table.insert(lines, '    "dungeonDifficulty": "' .. tostring(data.Dungeon.dungeonDifficulty) .. '",')
    table.insert(lines, '    "AutoReplay": ' .. tostring(data.Dungeon.AutoReplay))
    table.insert(lines, '  },')
    
    -- ⚔️ Section 2: Combat & Déplacement
    table.insert(lines, '  "Combat": {')
    table.insert(lines, '    "MoveSpeed": ' .. tostring(data.Combat.MoveSpeed) .. ',')
    table.insert(lines, '    "CombatRange": ' .. tostring(data.Combat.CombatRange) .. ',')
    table.insert(lines, '    "CombatRangeBoss": ' .. tostring(data.Combat.CombatRangeBoss) .. ',')
    table.insert(lines, '    "StrafeDistance": ' .. tostring(data.Combat.StrafeDistance) .. ',')
